<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AntiAway.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="WindowRoot" Background="{StaticResource AntiAwayPanelBrush}">
        <Grid x:Name="MainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragRegion" Grid.Row="0" Background="#12FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="18,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AntiAwaySecondaryBrush}"
                    Text="AntiAway" />

                <FontIcon
                    x:Name="HeaderBolt"
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="13"
                    Foreground="{StaticResource AntiAwaySecondaryBrush}"
                    Glyph="&#xE945;" />

                <TextBlock
                    x:Name="ClockText"
                    Grid.Column="2"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#AAFFFFFF" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16,18,14" Spacing="0">
                    <Border
                        MinHeight="72"
                        Padding="15,12"
                        Background="{StaticResource AntiAwaySurfaceBrush}"
                        CornerRadius="17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="StatusIconBackground"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#2BFFFFFF"
                                CornerRadius="20">
                                <FontIcon
                                    x:Name="StatusIcon"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="15"
                                    Foreground="#B8FFFFFF"
                                    Glyph="&#xE769;" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock
                                    x:Name="StatusTitleText"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White" />
                                <TextBlock
                                    x:Name="StatusDetailText"
                                    FontSize="12"
                                    Foreground="{StaticResource AntiAwaySecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Grid.Column="2"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#18FFFFFF"
                                CornerRadius="11">
                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="7"
                                    Height="7"
                                    Fill="#48FFFFFF" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Height="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Foreground="{StaticResource AntiAwaySecondaryBrush}"
                                Glyph="&#xE726;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="Stay active" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StayActiveToggle"
                            Grid.Column="1"
                            OffContent=""
                            OnContent=""
                            Toggled="StayActiveToggle_Toggled" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource AntiAwayLineBrush}" />

                    <Grid Height="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Foreground="{StaticResource AntiAwaySecondaryBrush}"
                                Glyph="&#xE823;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="Activity interval" />
                        </StackPanel>
                        <ComboBox
                            x:Name="IntervalComboBox"
                            Grid.Column="1"
                            MinWidth="104"
                            DisplayMemberPath="ShortTitle"
                            SelectionChanged="IntervalComboBox_SelectionChanged" />
                    </Grid>

                    <Grid Height="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Foreground="{StaticResource AntiAwaySecondaryBrush}"
                                Glyph="&#xE7E8;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="Launch at login" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="LaunchAtLoginToggle"
                            Grid.Column="1"
                            OffContent=""
                            OnContent=""
                            Toggled="LaunchAtLoginToggle_Toggled" />
                    </Grid>

                    <Border
                        MinHeight="42"
                        Padding="12,8"
                        Background="#12C7FF33"
                        BorderBrush="#55C7FF33"
                        BorderThickness="1"
                        CornerRadius="11">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource AntiAwayAccentBrush}"
                                Text="◇" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#A8FFFFFF"
                                Text="Local only. No clicks, typing, or tracking."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="ErrorPanel"
                        Margin="0,10,0,0"
                        Padding="12,10"
                        Background="#30FF9F0A"
                        BorderBrush="#80FF9F0A"
                        BorderThickness="1"
                        CornerRadius="11"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ErrorText"
                                FontSize="11"
                                Foreground="#FFFFD8A8"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="6,2"
                                Click="DismissErrorButton_Click"
                                Content="Dismiss" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,14,0,0" Height="34">
                        <Button
                            HorizontalAlignment="Left"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SettingsButton_Click"
                            Foreground="#80FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Glyph="&#xE713;" />
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="Settings" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Right"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="QuitButton_Click"
                            Foreground="#80FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Glyph="&#xE7E8;" />
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="Quit" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="OnboardingPanel"
            Padding="26,22"
            Background="{StaticResource AntiAwayPanelBrush}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center" Spacing="11">
                <Border
                    Width="72"
                    Height="72"
                    Background="#25C7FF33"
                    CornerRadius="36">
                    <Image
                        Width="48"
                        Height="48"
                        Source="Assets/AntiAwayIcon.png"
                        Stretch="Uniform" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="23"
                    FontWeight="SemiBold"
                    Text="Welcome to AntiAway" />
                <TextBlock
                    MaxWidth="330"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource AntiAwaySecondaryBrush}"
                    Text="Keep your work presence active with a small local signal that never moves your pointer, clicks, or types."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,24,0,16" Spacing="10" VerticalAlignment="Center">
                <Border Padding="13" Background="{StaticResource AntiAwaySurfaceBrush}" CornerRadius="13">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="No special permission" />
                        <TextBlock FontSize="11" Foreground="{StaticResource AntiAwaySecondaryBrush}" Text="Runs with your normal Windows account—never as administrator." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="13" Background="{StaticResource AntiAwaySurfaceBrush}" CornerRadius="13">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="Private by design" />
                        <TextBlock FontSize="11" Foreground="{StaticResource AntiAwaySecondaryBrush}" Text="No screenshots, key recording, network calls, or analytics." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="13" Background="{StaticResource AntiAwaySurfaceBrush}" CornerRadius="13">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="Lives in the system tray" />
                        <TextBlock FontSize="11" Foreground="{StaticResource AntiAwaySecondaryBrush}" Text="Close the panel anytime; AntiAway keeps running quietly." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Padding="14,10"
                Background="{StaticResource AntiAwayAccentBrush}"
                Click="ContinueButton_Click"
                Content="Continue"
                Foreground="#FF151810"
                FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>

